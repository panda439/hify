# 容器内运行 Hify 后端时用的环境变量（docker compose --profile app）。
# 复制成 .env.docker 后按需修改；.env.docker 已被 gitignore，可以放真实密钥。
#
# 和根目录 .env 的区别只有一处但很关键：主机名。.env 是给「跑在宿主机上的
# air/go run」用的，所以写 127.0.0.1:3307 这类映射到宿主的端口；容器内要走
# compose 网络的服务名和容器内部端口（3306/5432/6379），不是映射后的端口。

HIFY_ENV="production"
HIFY_HTTP_ADDR=":8080"

# 服务名 + 容器内端口，不是宿主机映射的 3307/5433/6380
HIFY_MYSQL_DSN="hify:hify_dev@tcp(mysql:3306)/hify?parseTime=true&loc=UTC&charset=utf8mb4"
HIFY_POSTGRES_DSN="postgres://hify:hify_dev@postgres:5432/hify?sslmode=disable"
HIFY_REDIS_ADDR="redis:6379"
HIFY_REDIS_PASSWORD=""
HIFY_REDIS_DB="0"

# 这两个换成你自己的值。HIFY_ENCRYPTION_KEY 必须和加密现有
# model_providers.api_key 时用的那把一致，否则已存的供应商密钥全部解不开。
HIFY_JWT_SECRET="请替换成 64 字节随机 base64"
HIFY_JWT_ACCESS_TTL="20m"
HIFY_JWT_REFRESH_TTL="720h"
HIFY_ENCRYPTION_KEY="请替换成 32 字节随机 base64"

# 前端由同一个二进制以 go:embed 提供，同源，不需要跨域白名单。
HIFY_CORS_ALLOWED_ORIGINS=""

# seed-admin 子命令用；serve/migrate 不读
ADMIN_EMAIL="admin@hify.local"
ADMIN_PASSWORD="请替换"

# 知识库原始文件目录，对应 compose 里的 hify_app_data volume，别改
HIFY_KNOWLEDGE_STORAGE_DIR="/app/data/knowledge"

# ---------------------------------------------------------------------
# 关于 ollama：它不在 compose 里，跑在宿主机上（mac 上必须如此——Docker
# Desktop 拿不到 Metal GPU，塞进容器只能用 CPU）。容器访问它的地址是
# http://host.docker.internal:11434/v1，这个值填在 Web 界面的「模型供应商」
# 里（存在 MySQL 的 model_providers.base_url），不是环境变量。
#
# 前提：宿主机的 ollama 必须监听 0.0.0.0 而不是默认的 127.0.0.1，否则容器
# 连不进来。见 README 的部署一节。
# ---------------------------------------------------------------------
