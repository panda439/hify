# 复制为 .env 后按需修改，本地开发默认值和 docker-compose.yml 保持一致。
# 值统一加双引号——Makefile 用 `include .env` + shell `source` 加载这个文件，
# DSN 里的 & 之类字符不加引号会被 shell 当成特殊字符解析出错。

HIFY_ENV="development"
HIFY_HTTP_ADDR=":8080"

# MySQL DSN（database/sql + go-sql-driver/mysql 格式），parseTime 必须开，统一按 UTC 处理时间
# 注意端口是 3307 不是 3306——这台机器 3306 已经被一个原生 mysqld 占用，docker-compose.yml 里改了映射
HIFY_MYSQL_DSN="hify:hify_dev@tcp(127.0.0.1:3307)/hify?parseTime=true&loc=UTC&charset=utf8mb4"

# Redis（6380 不是 6379——6379 被另一个项目的容器占用了）
HIFY_REDIS_ADDR="127.0.0.1:6380"
HIFY_REDIS_PASSWORD=""
HIFY_REDIS_DB="0"

# JWT
HIFY_JWT_SECRET="change-me-in-production-32-bytes-min"
HIFY_JWT_ACCESS_TTL="20m"
HIFY_JWT_REFRESH_TTL="720h"

# AES-256-GCM，用于加密 model_providers.api_key，32 字节 base64
HIFY_ENCRYPTION_KEY="change-me-32-byte-base64-encoded-key=="

# 首个 admin 账号，hify seed-admin 子命令读取
ADMIN_EMAIL="admin@hify.local"
ADMIN_PASSWORD="change-me-please"

# 允许跨域的前端来源，逗号分隔；生产环境是同源(go:embed)不需要额外配置
HIFY_CORS_ALLOWED_ORIGINS="http://localhost:5173"
